# Explicit exclusions take precedence over the public manifest above.
# Keep these last so secrets and generated clutter remain excluded if the manifest grows.

# Environment files, credentials, signing keys, and wallet material
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
keystores/
wallets/

# macOS and Windows metadata
.DS_Store
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editor settings, swap files, and backups
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# Python environments, bytecode, tooling caches, and coverage
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Foundry and other generated dependencies/build artifacts
.foundry/
cache/
out/
broadcast/
node_modules/
build/
dist/
coverage/
.cache/

# Local databases, logs, and experiment evidence
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.log
logs/
evidence/
